{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "服务中心",
  "version": "0.1.0",
  "identifier": "com.kacent.center",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "服务中心", "width": 1440, "height": 940, "minWidth": 1060, "minHeight": 720, "backgroundColor": "#1b222a", "center": true }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "管理本地服务、独立终端与 AI Agent",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "13.0", "infoPlist": "Info.plist" },
    "windows": { "nsis": { "languages": ["SimpChinese"], "displayLanguageSelector": false } }
  }
}
